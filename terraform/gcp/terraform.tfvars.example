# Copy to terraform.tfvars (git-ignored) and fill in.
project_id = "<your-gcp-project-id>"
region     = "asia-south1"
zone       = "asia-south1-a"
name       = "idea-board"

# --- GKE ---
machine_type = "e2-standard-2" # 2 vCPU, 8 GiB (≈ t3.large)
spot         = true
node_count   = 1

# --- step 2: Argo CD (after step 1 + the static IP is in overlays/gcp) ---
install_addons = false
git_repo_url   = "https://github.com/<your-github-username>/idea-board.git"

# Private repo? Do NOT put the token here:
#   export TF_VAR_git_username=<you>
#   export TF_VAR_git_token=<read-only token>
