# =============================================================================
# app/backend/.env.example – documented local settings for running the backend
# OUTSIDE containers (Phase 3). Copy to `.env` (git-ignored) and adjust:
#     cp .env.example .env
# pydantic-settings reads `.env` automatically from the working directory.
# SECURITY NOTE: these are throwaway LOCAL passwords for a disposable container DB.
#   In the cloud the DB_* values come from Kubernetes Secrets written by terraform –
#   never from a committed file.
# LEARN: docs/learning/10-backend-python-fastapi.md §5, §7
# =============================================================================
APP_ENV=local
LOG_LEVEL=INFO
# Human-friendly coloured logs in your terminal; keep false anywhere logs are shipped.
LOG_PRETTY=true

DB_HOST=localhost
DB_PORT=55432
DB_NAME=ideas
# The API runs as the least-privileged app role created by `idea-board-db-bootstrap`.
DB_USER=ideas_app
DB_PASSWORD=app-pass-local-only
DB_SSLMODE=disable

# Owner credentials: ONLY for `alembic` and `idea-board-db-bootstrap` (DDL rights).
BOOTSTRAP_OWNER_USER=owner
BOOTSTRAP_OWNER_PASSWORD=owner-pass-local-only

# Demo-only fault injection (0 = off). Try 0.5 to watch the 500s in logs/metrics.
FAULT_INJECTION_RATE=0
